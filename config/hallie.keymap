#undef ZMK_BEHAVIORS_KEEP_ALL

#define ZMK_BEHAVIORS_KEEP_IND
#define ZMK_BEHAVIORS_KEEP_BT
#define ZMK_BEHAVIORS_KEEP_GRESC
#define ZMK_BEHAVIORS_KEEP_SYS_RESET
#define ZMK_BEHAVIORS_KEEP_BOOTLOADER
#define ZMK_BEHAVIORS_KEEP_CAPS_WORD
#define ZMK_BEHAVIORS_KEEP_KEY_REPEAT
#define ZMK_BEHAVIORS_KEEP_KT
#define ZMK_BEHAVIORS_KEEP_LT
#define ZMK_BEHAVIORS_KEEP_MT
#define ZMK_BEHAVIORS_KEEP_SK
#define ZMK_BEHAVIORS_KEEP_STICKY_LAYER
#define ZMK_BEHAVIORS_KEEP_TO
#define ZMK_BEHAVIORS_KEEP_TOG
#define ZMK_BEHAVIORS_KEEP_TRANS

#include <behaviors/indicators.dtsi>
#include <dt-bindings/zmk/indicators.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

/ {
    behaviors {
        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
            hold-trigger-on-release;
        };

        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            quick-tap-ms = <175>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&caps_word  &kp Q            &kp W         &kp F            &kp P              &kp G          &kp J      &kp L               &kp U             &kp Y                 &kp SEMICOLON     &mkp LCLK
&trans      &HML LEFT_WIN A  &HML LCTRL R  &HML LEFT_ALT S  &HML LEFT_SHIFT T  &kp D          &kp H      &HMR RIGHT_SHIFT N  &HMR RIGHT_ALT E  &HMR RIGHT_CONTROL I  &HMR RIGHT_GUI O  &mkp RCLK
&trans      &kp Z            &kp X         &kp C            &kp V              &kp B          &kp K      &kp M               &kp COMMA         &kp DOT               &kp SLASH         &mkp MCLK
                                           &kp TAB          &kp BACKSPACE      &lt 1 ENTER    &kp ENTER  &lt 2 ESCAPE        &tog 3
            >;

            sensor-bindings =
                <&inc_dec_kp C_VOL_DN C_VOL_UP>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        raise_layer {
            bindings = <
&mmv MOVE_UP    &kt EXCL          &kp AT_SIGN  &kt HASH   &kp DOLLAR         &kp PERCENT    &kp CARET       &kp AMPERSAND  &kp STAR          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&mmv MOVE_LEFT  &kp PRINTSCREEN   &kp GRAVE    &kp TILDE  &kp SINGLE_QUOTE   &trans         &kp MINUS       &kp EQUAL      &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp BACKSLASH          &mmv MOVE_RIGHT
&trans          &kp C_PLAY_PAUSE  &trans       &trans     &kp DOUBLE_QUOTES  &trans         &kp UNDERSCORE  &kp PLUS       &kp LEFT_BRACE    &kp RIGHT_BRACE       &kp PIPE               &trans
                                               &trans     &trans             &trans         &trans          &trans         &trans
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW &inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };

        lower_layer {
            bindings = <
&bt BT_SEL 0  &trans  &kp N7  &kp N8  &kp N9  &trans    &kp F1  &kp F2          &kp F3          &kp F4        &kp F5           &bt BT_CLR_ALL
&bt BT_SEL 1  &trans  &kp N4  &kp N5  &kp N6  &trans    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &trans
&bt BT_SEL 2  &trans  &kp N1  &kp N2  &kp N3  &kp N0    &trans  &trans          &trans          &trans        &trans           &trans
                              &trans  &trans  &trans    &trans  &trans          &trans
            >;

            sensor-bindings =
                <&inc_dec_kp PG_DN PG_UP>,
                <&inc_dec_kp DELETE BACKSPACE>;
        };

        layer_3 {
            bindings = <
&trans  &kp Q            &kp W                &kp E            &kp R              &kp T     &kp Y   &kp U               &kp I             &kp O                 &kp P                &kp LEFT_BRACKET
&trans  &HML LEFT_GUI A  &HML LEFT_CONTROL S  &HML LEFT_ALT D  &HML LEFT_SHIFT F  &kp G     &kp H   &HMR RIGHT_SHIFT J  &HMR RIGHT_ALT K  &HMR RIGHT_CONTROL L  &HMR RIGHT_GUI SEMI  &kp SINGLE_QUOTE
&trans  &kp Z            &kp X                &kp C            &kp V              &kp B     &kp N   &kp M               &kp COMMA         &kp DOT               &kp FSLH             &kp RIGHT_BRACKET
                                              &trans           &trans             &trans    &trans  &trans              &tog 3
            >;
        };
    };
};
